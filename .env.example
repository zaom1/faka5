# =====================================================
# FakaShop 环境变量配置（示例）
# 开源版本 - 用户自行部署时参考此文件
# =====================================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 将所有 YOUR-xxx 替换为实际值
# 3. 不要将 .env 文件提交到 Git 仓库

# --- Supabase 数据库配置 ---
# Supabase 项目 URL (从控制台获取: Settings → API)
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co

# Supabase anon public key (从控制台获取: Settings → API)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR-ANON-KEY

# 直接数据库连接（可选，仅用于后端服务）
DB_HOST=db.YOUR-PROJECT-ID.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=YOUR-DATABASE-PASSWORD

# 完整连接字符串（可选）
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-ID.supabase.co:5432/postgres

# --- 支付配置 ---
# NexaPay USDT 收款地址 (TRC20 网络)
NEXAPAY_CRYPTO_ADDRESS=YOUR-USDT-TRC20-ADDRESS

# NexaPay Webhook Secret (用于支付回调验证)
NEXAPAY_WEBHOOK_SECRET=YOUR-WEBHOOK-SECRET

# --- 安全配置 ---
# 管理员 JWT Token 签名密钥（建议使用强随机字符串）
ADMIN_JWT_SECRET=YOUR-STRONG-RANDOM-SECRET-KEY-HERE

# 可选：OpenAI API Key (用于 AI 功能)
# OPENAI_API_KEY=sk-your-openai-key
